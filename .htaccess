# ===================================
# CONFIGURAÇÃO APACHE - CLOVIS RIBEIRO
# Versão 8.0.0 - Refinamento Arquitetural Máximo
# ===================================

# Ativar RewriteEngine
RewriteEngine On

# ===================================
# FORÇAR HTTPS E REMOVER WWW (ATUALIZADO)
# ===================================
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.clovisribeiro\.com$ [NC]
RewriteRule ^(.*)$ https://clovisribeiro.com/$1 [R=301,L]

# ===================================
# COMPRESSÃO GZIP
# ===================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  
  # Remover ETags problemáticos
  Header unset ETag
  FileETag None
</IfModule>

# ===================================
# CACHE DE RECURSOS ESTÁTICOS
# ===================================
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: revalidar sempre
  ExpiresByType text/html "access plus 0 seconds"

  # CSS e JavaScript: 1 dia
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType application/x-javascript "access plus 1 day"

  # Imagens: 7 dias
  ExpiresByType image/jpg "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/gif "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/avif "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"

  # Fontes locais: 1 ano
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # Documentos
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# ===================================
# HEADERS DE SEGURANÇA
# ===================================
<IfModule mod_headers.c>
  # Proteção XSS
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  
  # Política de Referrer
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Content Security Policy (CSP)
  Header always set Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com; frame-ancestors 'self';"
  
  # Permissions Policy (Feature Policy)
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  
  # HSTS (HTTP Strict Transport Security) - Ativar após confirmar HTTPS
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  
  # Cache-Control alinhado a arquivos sem fingerprint
  <FilesMatch "\.(html?|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.(woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ===================================
# BLOQUEAR ACESSO A ARQUIVOS SENSÍVEIS
# ===================================
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# Bloquear acesso a arquivos de configuração
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|conf|bak|config)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# ===================================
# PÁGINA DE ERRO PERSONALIZADA
# ===================================
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html

# ===================================
# PROTEÇÃO CONTRA HOTLINKING DE IMAGENS
# ===================================
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https://(www\.)?clovisribeiro\.com [NC]
RewriteRule \.(jpg|jpeg|png|gif|webp|svg)$ - [F,L]

# ===================================
# DESABILITAR LISTAGEM DE DIRETÓRIOS
# ===================================
Options -Indexes

# ===================================
# CHARSET UTF-8
# ===================================
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .xml .json .txt

# ===================================
# MIME TYPES MODERNOS
# ===================================
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/javascript .js
  AddType application/json .json
</IfModule>